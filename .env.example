LUFT_SISTEMA_ID=0
LUFT_APLICACAO_VERSAO=0.1.0
LUFT_AMBIENTE=desenvolvimento

LUFT_VAULT_ENDERECO=http://servidor-vault:8200
LUFT_VAULT_NAMESPACE=luft
LUFT_VAULT_TOKEN=<TOKEN_VAULT_PROTEGIDO>
LUFT_TOKEN_ACESSO=<TOKEN_ACESSO_DA_APLICACAO>

LUFT_LDAP_SERVIDOR=<SERVIDOR_LDAP>
LUFT_LDAP_DOMINIO=LUFTFARMA
LUFT_LDAP_TRANSPORTE=ldaps
LUFT_LDAP_PORTA=636
LUFT_LDAP_TIMEOUT_SEGUNDOS=5

LUFT_SESSAO_COOKIE_NOME=luft_sessao
LUFT_SESSAO_COOKIE_DOMINIO=
LUFT_SESSAO_COOKIE_CAMINHO=/
LUFT_SESSAO_COOKIE_SAMESITE=Lax
LUFT_SESSAO_COOKIE_SEGURO=false
LUFT_SESSAO_TTL_MINUTOS=480

LUFT_AUTORIZACAO_TTL_SEGUNDOS=300
LUFT_AUTORIZACAO_REVISAO_TTL_SEGUNDOS=5
LUFT_AUTORIZACAO_MAX_CHAVES=100

# Endereco publico da plataforma, usado nos links dos e-mails de acesso liberado (vazio = host da requisicao)
# LUFT_URL_PUBLICA=https://portal.exemplo.com.br

# Alertas para o desenvolvedor: ligue SO no Workspace (o avaliador le a trilha de todos os sistemas)
# LUFT_ALERTAS_ATIVO=true
# LUFT_ALERTAS_INTERVALO_SEGUNDOS=60

# Retencao dos logs (dias) usada por `luftbase banco retencao`
# LUFT_RETENCAO_ACESSO_DIAS=180
# LUFT_RETENCAO_SESSOES_DIAS=365
# LUFT_RETENCAO_EVENTOS_DIAS=730
# LUFT_RETENCAO_ALERTAS_DIAS=180
